# 默认：文本文件统一 LF，检出时按平台转换由 eol 决定
* text=auto eol=lf

# Go 与文档一律 LF
*.go        text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
Makefile    text eol=lf

# Windows 脚本保留 CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.gz        binary

# 生成文件：折叠 diff、不计入语言统计
go.sum              linguist-generated=true
/go.sum             linguist-generated=true
docs/**             linguist-documentation=true
